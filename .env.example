# Copy to .env and fill in real values. Never commit .env to git.
# Shared app password (first screen of the app, two users share it)
APP_PASSWORD=change-me
# Secret for signing JWT access tokens (long random string)
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime (no logout button, so it is long-lived)
JWT_EXPIRES_IN=365d
# Public port of the web service (port 80 is occupied on the real server)
WEB_PORT=8080
